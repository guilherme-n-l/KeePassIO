#!/usr/bin/env bash
# Enforces the commit message format described in CONTRIBUTING.md.
set -euo pipefail

msg_file="$1"
# Ignore comment lines that git strips from the final message.
message="$(grep -v '^#' "$msg_file" || true)"
subject="$(printf '%s\n' "$message" | sed -n '1p')"
second="$(printf '%s\n' "$message" | sed -n '2p')"
body="$(printf '%s\n' "$message" | sed -n '3,$p' | { grep -v '^[A-Za-z-]*: ' || true; } | tr -d '[:space:]')"

# Merge commits generated by git keep their default message.
if [[ "$subject" =~ ^Merge\  ]]; then
  exit 0
fi

errors=()
[[ -n "$subject" ]] || errors+=("the subject line is empty")
((${#subject} <= 72)) || errors+=("the subject is ${#subject} characters; keep it at 72 or fewer")
[[ ! "$subject" =~ \.$ ]] || errors+=("the subject must not end with a period")
[[ "$subject" =~ ^[A-Z] ]] || errors+=("the subject must start with a capital letter")
[[ -z "$second" ]] || errors+=("leave a blank line between the subject and the body")
[[ -n "$body" ]] || errors+=("add a body explaining what changed and why")

if ((${#errors[@]})); then
  echo "commit-msg: the commit message does not follow CONTRIBUTING.md:" >&2
  printf '  - %s\n' "${errors[@]}" >&2
  exit 1
fi
